# LIFELINE Phase 1 — environment configuration
# Copy this file to .env and adjust values as needed. Never commit .env.

# Database (SQLite for Phase 1; swap for a Postgres URL in a later phase without schema changes)
DATABASE_URL=sqlite:///./lifeline.db

# Demo auth pepper — used to salt/pepper the simple Phase 1 password hashing scheme.
# Replace with a real secret before any non-demo deployment.
AUTH_PEPPER=change-this-pepper-in-production

# Cost estimation constants (used by services/cost_service.py)
FUEL_EFFICIENCY_KM_PER_LITRE=8.0
FUEL_COST_PER_LITRE_KES=180.0
OPERATING_COST_PER_KM_KES=45.0
AVERAGE_SPEED_KMH=40.0

# Simulated ambulance movement step size (% of total mission distance per "Update Position" click)
SIMULATION_STEP_PERCENT=20.0
